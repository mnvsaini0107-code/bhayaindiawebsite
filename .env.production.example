# BHAYA INDIA — PRODUCTION ENVIRONMENT CONFIGURATION (STANDALONE COMMERCE)

NODE_ENV=production
PORT=3000

# Base Public URL (e.g., https://bhayaindia.com or your Render/Railway/VPS URL)
NEXT_PUBLIC_SITE_URL=https://bhayaindia.com

# 100% Standalone Commerce Engine (Zero external dependencies)
COMMERCE_MODE=standalone

# Admin Security Credentials
# Generate strong, random 32+ character secrets for production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_strong_password_in_production
ADMIN_JWT_SECRET=generate_a_random_sha256_secret_key_here

# Optional: Custom WhatsApp contact number for direct customer orders & inquiries
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
