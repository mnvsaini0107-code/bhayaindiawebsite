   }
 }
+
+/* =========================================================
+   FOUNDER PROFILE PAGE STYLES (Next.js & OS 2.0 Parity)
+   ========================================================= */
+.founder-profile-section {
+  padding-top: 2rem;
+  padding-bottom: 5rem;
+  background-color: #ffffff;
+}
+
+.founder-profile-breadcrumb {
+  font-size: 0.8125rem;
+  color: var(--text-muted);
+  margin-bottom: 2.5rem;
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+  flex-wrap: wrap;
+}
+
+.founder-profile-breadcrumb a {
+  color: var(--text-secondary);
+  text-decoration: none;
+  transition: color var(--duration-fast);
+}
+
+.founder-profile-breadcrumb a:hover {
+  color: var(--gold);
+}
+
+.breadcrumb-sep {
+  color: var(--text-muted);
+}
+
+.founder-profile-hero {
+  display: grid;
+  grid-template-columns: 420px 1fr;
+  gap: clamp(2.5rem, 5vw, 4.5rem);
+  align-items: start;
+  margin-bottom: 3.5rem;
+}
+
+.founder-profile-visual {
+  width: 100%;
+}
+
+.founder-profile-portrait-card {
+  position: relative;
+  width: 100%;
+  aspect-ratio: 4 / 5.2;
+  border-radius: 12px;
+  overflow: hidden;
+  border: 2px solid rgba(197, 160, 89, 0.4);
+  box-shadow: 0 20px 48px rgba(18, 52, 86, 0.12);
+  background-color: var(--sapphire);
+}
+
+.founder-profile-badge {
+  position: absolute;
+  bottom: 0;
+  left: 0;
+  right: 0;
+  padding: 1.5rem 1.75rem;
+  background: linear-gradient(180deg, transparent 0%, rgba(18, 52, 86, 0.94) 45%, rgba(18, 52, 86, 0.99) 100%);
+  display: flex;
+  flex-direction: column;
+  gap: 0.25rem;
+  z-index: 2;
+}
+
+.founder-profile-badge .badge-title {
+  color: #ffffff;
+  font-family: var(--font-primary);
+  font-size: 1.3125rem;
+  font-weight: 700;
+}
+
+.founder-profile-badge .badge-subtitle {
+  color: var(--gold);
+  font-size: 0.875rem;
+  font-weight: 600;
+}
+
+.founder-profile-badge .badge-origin {
+  color: rgba(255, 255, 255, 0.75);
+  font-size: 0.75rem;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.founder-profile-intro {
+  display: flex;
+  flex-direction: column;
+}
+
+.founder-profile-title {
+  font-family: var(--font-primary);
+  font-size: clamp(2.25rem, 4vw, 3.25rem);
+  font-weight: 700;
+  color: var(--sapphire);
+  line-height: 1.15;
+  margin: 0.5rem 0 0.35rem 0;
+}
+
+.founder-profile-designation {
+  font-size: 1.125rem;
+  font-weight: 600;
+  color: var(--gold-dark);
+  margin-bottom: 1.5rem;
+  letter-spacing: 0.02em;
+}
+
+.founder-profile-pullquote {
+  margin: 0 0 2rem 0;
+  padding: 1.25rem 1.75rem;
+  border-left: 4px solid var(--gold);
+  background: var(--ivory-warm);
+  border-radius: 0 8px 8px 0;
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+}
+
+.founder-profile-pullquote .pullquote-text {
+  font-size: 1.5rem;
+  font-weight: 700;
+  color: var(--sapphire);
+}
+
+.founder-profile-pullquote .pullquote-sub {
+  font-size: 0.8125rem;
+  color: var(--text-muted);
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.founder-profile-body p {
+  font-size: 1.0625rem;
+  line-height: 1.85;
+  color: var(--text-secondary);
+  margin-bottom: 1.25rem;
+}
+
+.founder-profile-vision-card {
+  background: linear-gradient(135deg, rgba(18, 52, 86, 0.03) 0%, rgba(197, 160, 89, 0.08) 100%);
+  border: 1px solid rgba(197, 160, 89, 0.35);
+  border-radius: 12px;
+  padding: clamp(2rem, 4vw, 3rem);
+  margin-bottom: 4rem;
+  box-shadow: 0 8px 24px rgba(18, 52, 86, 0.04);
+}
+
+.vision-card-heading {
+  font-family: var(--font-primary);
+  font-size: clamp(1.625rem, 3vw, 2.25rem);
+  font-weight: 700;
+  color: var(--sapphire);
+  margin-top: 0.5rem;
+  margin-bottom: 1rem;
+}
+
+.vision-card-text {
+  font-size: 1.125rem;
+  line-height: 1.85;
+  color: var(--text-secondary);
+  margin: 0;
+}
+
+.founder-profile-philosophy {
+  margin-bottom: 4rem;
+}
+
+.philosophy-heading {
+  font-family: var(--font-primary);
+  font-size: clamp(1.875rem, 3.5vw, 2.5rem);
+  font-weight: 700;
+  color: var(--sapphire);
+  margin-top: 0.5rem;
+  margin-bottom: 0.75rem;
+}
+
+.philosophy-subheading {
+  font-size: 1.0625rem;
+  color: var(--text-secondary);
+  max-width: 640px;
+  margin: 0 auto;
+}
+
+.philosophy-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
+  gap: 1.5rem;
+  margin-top: 2.5rem;
+  margin-bottom: 1.5rem;
+}
+
+.philosophy-card {
+  position: relative;
+  background: #ffffff;
+  border: 1px solid rgba(18, 52, 86, 0.1);
+  border-radius: 12px;
+  padding: 1.75rem 1.5rem;
+  display: flex;
+  flex-direction: column;
+  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
+}
+
+.philosophy-card:hover {
+  transform: translateY(-4px);
+  box-shadow: 0 14px 32px rgba(18, 52, 86, 0.09);
+  border-color: var(--gold);
+}
+
+.philosophy-card-num {
+  font-size: 0.75rem;
+  font-weight: 700;
+  color: var(--gold);
+  letter-spacing: 0.12em;
+  margin-bottom: 0.75rem;
+}
+
+.philosophy-card-icon {
+  width: 46px;
+  height: 46px;
+  border-radius: 10px;
+  background: rgba(197, 160, 89, 0.12);
+  color: var(--sapphire);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  margin-bottom: 1.25rem;
+}
+
+.philosophy-card-title {
+  font-size: 1.25rem;
+  font-weight: 700;
+  color: var(--sapphire);
+  margin: 0 0 0.5rem 0;
+}
+
+.philosophy-card-desc {
+  font-size: 0.9375rem;
+  line-height: 1.65;
+  color: var(--text-secondary);
+  margin: 0;
+}
+
+.philosophy-disclaimer {
+  font-size: 0.8125rem;
+  color: var(--text-muted);
+  text-align: center;
+  font-style: italic;
+  margin-top: 1.25rem;
+}
+
+.founder-profile-future-box {
+  background-color: var(--sapphire);
+  border-radius: 14px;
+  padding: clamp(2.25rem, 4.5vw, 3.5rem);
+  margin-bottom: 4rem;
+  box-shadow: 0 20px 48px rgba(18, 52, 86, 0.16);
+  position: relative;
+  overflow: hidden;
+}
+
+.founder-profile-future-box::after {
+  content: "";
+  position: absolute;
+  top: -40%;
+  right: -20%;
+  width: 400px;
+  height: 400px;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(197, 160, 89, 0.15) 0%, transparent 70%);
+  pointer-events: none;
+}
+
+.future-box-heading {
+  font-family: var(--font-primary);
+  font-size: clamp(1.625rem, 3vw, 2.375rem);
+  font-weight: 700;
+  color: #ffffff;
+  margin-top: 0.5rem;
+  margin-bottom: 1rem;
+}
+
+.future-box-text {
+  font-size: 1.0625rem;
+  line-height: 1.85;
+  color: rgba(255, 255, 255, 0.9);
+  margin-bottom: 1.75rem;
+}
+
+.future-verticals-tags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.625rem;
+}
+
+.vtag {
+  background: rgba(255, 255, 255, 0.1);
+  border: 1px solid rgba(197, 160, 89, 0.45);
+  color: var(--gold-light);
+  padding: 0.45rem 0.9375rem;
+  border-radius: 999px;
+  font-size: 0.8125rem;
+  font-weight: 600;
+  letter-spacing: 0.03em;
+}
+
+.founder-profile-closing {
+  text-align: center;
+  padding: clamp(2.5rem, 5vw, 4rem) 1.5rem;
+  background-color: var(--ivory-warm);
+  border-radius: 14px;
+  border: 1px solid rgba(197, 160, 89, 0.35);
+}
+
+.closing-badge {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.5rem;
+  margin-bottom: 2rem;
+}
+
+.closing-motto {
+  font-size: clamp(1.75rem, 3.5vw, 2.5rem);
+  font-weight: 700;
+  color: var(--sapphire);
+}
+
+.closing-brand {
+  font-size: 0.875rem;
+  letter-spacing: 0.18em;
+  font-weight: 700;
+  color: var(--gold);
+  text-transform: uppercase;
+}
+
+.founder-profile-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 1rem;
+  margin-bottom: 2rem;
+}
+
+.founder-profile-contact-info {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  align-items: center;
+  gap: 0.75rem;
+  font-size: 0.875rem;
+  color: var(--text-secondary);
+}
+
+.founder-profile-contact-info a {
+  color: var(--sapphire);
+  font-weight: 600;
+  text-decoration: none;
+}
+
+.founder-profile-contact-info a:hover {
+  color: var(--gold);
+}
+
+.founder-profile-contact-info .bullet {
+  color: var(--gold);
+}
+
+@media (max-width: 991px) {
+  .founder-profile-hero {
+    grid-template-columns: 1fr;
+    gap: 2.5rem;
+  }
+  .founder-profile-portrait-card {
+    max-width: 380px;
+    margin: 0 auto;
+  }
+}
+
+@media (max-width: 576px) {
+  .founder-profile-portrait-card {
+    max-width: 100%;
+    aspect-ratio: 4 / 4.8;
+  }
+  .philosophy-grid {
+    grid-template-columns: 1fr;
+  }
+  .founder-profile-actions {
+    flex-direction: column;
+    width: 100%;
+    align-items: stretch;
+  }
+  .founder-profile-actions .btn {
+    width: 100%;
+    text-align: center;
+    justify-content: center;
+  }
+  .founder-profile-contact-info {
+    flex-direction: column;
+    gap: 0.35rem;
+  }
+  .founder-profile-contact-info .bullet {
+    display: none;
+  }
+}
+
